DATABASE_URL=postgres://paybox:paybox@localhost:5433/paybox
PAYSTACK_MODE=fake
PORT=4000
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
API_URL=http://localhost:4000
DEMO_MODE=true
# Required for PAYSTACK_MODE=test. Supply a sk_test_ key through your environment.
PAYSTACK_SECRET_KEY=
# Comma-separated whsec_ signing secrets, newest first.
PAYSTACK_WEBHOOK_SECRETS=
PAYSTACK_ACCEPT_LEGACY_SIGNATURE=false
# Test mode: generate SESSION_SECRET with openssl rand -hex 32.
SESSION_SECRET=
# Test mode: generate DATA_KEY with openssl rand -base64 32.
DATA_KEY=
# Fake mode generates persistent local-only secrets on first boot.
RECON_CRON=0 2 * * *
TEST_DATABASE_URL=postgres://paybox:paybox@localhost:55432/paybox_test
