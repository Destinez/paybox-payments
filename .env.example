# Local development only. Compose supplies its own internal database hostname.
DATABASE_URL=postgres://paybox:paybox@localhost:5433/paybox
PROVIDER=mock
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# Replace both before exposing the service outside localhost.
API_AUTH_TOKEN=local-development-token
DASHBOARD_PASSWORD=
# Only sk_test_ keys are accepted when PROVIDER=paystack.
PAYSTACK_SECRET_KEY=
# Mock webhook signing only; this is a public local-development value.
MOCK_WEBHOOK_SECRET=local-mock-webhook-signing-value
RECONCILE_INTERVAL_MS=3600000
