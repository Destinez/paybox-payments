{
  "name": "paybox-payments",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter @paybox/api --filter @paybox/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @paybox/db migrate",
    "worker": "pnpm --filter @paybox/api worker"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3.2.4"
  }
}
