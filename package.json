{
  "name": "paybox-payments",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter @paybox/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @paybox/db migrate",
    "worker": "pnpm --filter api worker",
    "format": "biome check --write .",
    "demo:seed": "tsx apps/api/src/seed-cli.ts",
    "test:e2e:prepare": "tsx apps/api/test/prepare-e2e.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.19.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@biomejs/biome": "^2.3.5",
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^4.3.0",
    "@axe-core/playwright": "^4.11.0",
    "@apidevtools/swagger-parser": "^12.1.0"
  }
}
